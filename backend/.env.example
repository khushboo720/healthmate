# Copy this file to ".env" (same folder) and edit. Never commit the real .env file.

# --- AI provider (Google Gemini). Leave empty to run in clearly-labelled DEMO MODE. ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=30

# --- Security ---
# Long random string used to sign login tokens. If empty, one is generated and stored in data/.jwt_secret
JWT_SECRET=
JWT_EXPIRE_HOURS=8

# --- App ---
# Create the synthetic demo account (demo@healthmate.ai / Demo@1234) on startup
SEED_DEMO=true
# Allowed browser origins when the frontend runs on the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional overrides
# DATA_DIR=./data
# DB_PATH=./data/healthmate.db
